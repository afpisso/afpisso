{
  "buildCommand": "npm run build:ssg",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "afpisso.com" }],
      "destination": "https://byandresfe.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.+)\\.(webp|jpg|jpeg|png|svg|ico|woff2|woff|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary",         "value": "Accept" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" },
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\", </llms.txt>; rel=\"describedby\"; type=\"text/markdown\""
        },
        { "key": "Vary", "value": "Accept" }
      ]
    }
  ]
}
